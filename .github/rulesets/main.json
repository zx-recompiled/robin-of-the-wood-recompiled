{
  "name": "main: require CI",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "dismissal_restriction": {
          "enabled": false,
          "allowed_actors": []
        },
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "no game or ROM data committed"
          },
          {
            "context": "build, test and lint (ubuntu-latest)"
          },
          {
            "context": "build, test and lint (macos-latest)"
          },
          {
            "context": "dependency policy"
          },
          {
            "context": "build, test and lint (windows-latest)"
          }
        ]
      }
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "required_linear_history"
    }
  ],
  "bypass_actors": []
}
